# ==========================================
# Courier & Logistics Platform - Environment Template
# ==========================================

NODE_ENV=development
PORT=5000

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/courier_db?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/courier_db?schema=public

# Cryptographic JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis & Upstash Configuration
REDIS_URL=rediss://default:token@immortal-shiner-215128.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://immortal-shiner-215128.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
LOG_LEVEL=info

# Email Provider (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Payments & Webhooks Configuration
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# E-Commerce Outbound Webhooks & Integration
WEBHOOK_BASE_TIMEOUT_MS=8000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Aiven Apache Kafka Configuration (5 Topics Constrained)
KAFKA_BROKERS=kafka-host.aivencloud.com:14905
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your_aiven_kafka_password_here
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_CLIENT_ID=courier-logistics
KAFKA_GROUP_ID=courier-service
KAFKA_CONNECTION_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=30000


