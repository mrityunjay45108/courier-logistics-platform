# ==========================================
# Courier & Logistics Platform - Environment Template
# ==========================================

NODE_ENV=development
PORT=5000

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/courier_db?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/courier_db?schema=public

# Cryptographic JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Email Provider (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Payments & Webhooks Configuration
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here
