# ==========================================
# Courier & Logistics Platform - Environment Configuration
# ==========================================

# Server Environment
NODE_ENV=development
PORT=5000

# Client Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/courier_db?schema=public

# JWT Secrets (Generate strong random strings in production)
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional Redis Cache / Queue Configuration
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
